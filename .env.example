# Required: bot token from the Discord Developer Portal.
DISCORD_TOKEN=

# Optional: numeric development guild ID for fast slash-command sync.
# Leave empty to sync commands globally.
GUILD_ID=

# Optional paths/settings.
EVENTS_CONFIG_PATH=config/events.json
DEFAULT_TIMEZONE=UTC
TTS_VOICE=en-US-AriaNeural
TTS_CACHE_DIR=cache/tts
FFMPEG_EXECUTABLE=ffmpeg
# Restart-safe per-guild voice channel settings.
VOICE_CONFIG_PATH=config/voice_channels.json
# Linear PCM volume from 0.0 (mute) to 2.0 (200%); /volume changes a guild at runtime.
VOICE_VOLUME=1.0
DASHBOARD_CONFIG_PATH=config/dashboards.json
# Minimum 30 seconds; 60 is a conservative default for Discord API usage.
DASHBOARD_UPDATE_INTERVAL=60
# File updated when the bot is connected and ready; used by Docker health checks.
HEALTHCHECK_PATH=cache/health/ready
# Optional control API for the Next.js dashboard. Keep this token secret.
CONTROL_API_HOST=0.0.0.0
CONTROL_API_PORT=8765
CONTROL_API_TOKEN=
LOG_LEVEL=INFO
